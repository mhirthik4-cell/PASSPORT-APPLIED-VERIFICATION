print("DATASET PREVIEW (FIRST 3 APPLICANTS):")
display(df[["applicant_id", "full_name", "aadhaar", "pan", "voter_id", "bank_name", "kyc_status", "passport_number"]].head(3))

print("\nKYC APPROVAL COMPLIANCE SUMMARY:")
approval_counts = df["kyc_status"].value_counts().reset_index()
approval_counts.columns = ["Verification Status", "Applicant Count"]
display(approval_counts)

